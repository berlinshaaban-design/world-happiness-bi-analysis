    <DTS:Executable
      DTS:refId="Package\Execute SQL Task (FACT_TABLE)"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{0C7581AE-7E7C-4F04-BA27-35D9AA7CCC30}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Execute SQL Task (FACT_TABLE)"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{48CD62E6-37DB-4EDA-9E23-1A4970AB836D}"
          SQLTask:SqlStatementSource="INSERT INTO dbo.fact_Happiness_Final&#xA;SELECT&#xA;    h.*,&#xA;    g.GPI,&#xA;    r.Regime&#xA;FROM dbo.stg_Happiness_AllYears AS h&#xA;LEFT JOIN dbo.stg_GPI_AllYears AS g&#xA;    ON h.CountryName = g.Country&#xA;   AND h.[Year] = g.[Year]&#xA;LEFT JOIN dbo.stg_Regime AS r&#xA;    ON h.CountryName = r.CountryName;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Execute SQL Task(clean regime)"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{783F157F-1D50-4BB2-934E-F9079D28F928}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Execute SQL Task(clean regime)"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{48CD62E6-37DB-4EDA-9E23-1A4970AB836D}"
          SQLTask:SqlStatementSource="DELETE FROM dbo.stg_Regime&#xA;WHERE CountryName = 'congo';&#xA;&#xA;INSERT INTO dbo.stg_Regime (CountryName, Regime)&#xA;VALUES ('congo', 'Authoritarian regime');&#xA;&#xA;DELETE FROM dbo.stg_Regime&#xA;WHERE CountryName = 'north macedonia';&#xA;&#xA;INSERT INTO dbo.stg_Regime (CountryName, Regime)&#xA;VALUES ('north macedonia', 'Hybrid regime');&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
